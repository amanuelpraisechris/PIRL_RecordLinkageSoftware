@* Language Switcher Component for Ethiopian HDSS *@
@* Supports: Tigrinya, Amharic, English *@
@* Saves preference to localStorage for persistence *@

@inject IJSRuntime JS

<div class="language-switcher">
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="language-flag">@GetLanguageFlag(CurrentLanguage)</span>
            <span class="language-name">@GetLanguageName(CurrentLanguage)</span>
        </button>
        <ul class="dropdown-menu" aria-labelledby="languageDropdown">
            <li>
                <a class="dropdown-item @(CurrentLanguage == "ti" ? "active" : "")" href="#" @onclick="(() => ChangeLanguage("ti"))" @onclick:preventDefault>
                    <span class="language-flag">🇪🇹</span>
                    <span class="ethiopic-text">ትግርኛ</span>
                    <small class="text-muted">(Tigrinya)</small>
                </a>
            </li>
            <li>
                <a class="dropdown-item @(CurrentLanguage == "am" ? "active" : "")" href="#" @onclick="(() => ChangeLanguage("am"))" @onclick:preventDefault>
                    <span class="language-flag">🇪🇹</span>
                    <span class="ethiopic-text">አማርኛ</span>
                    <small class="text-muted">(Amharic)</small>
                </a>
            </li>
            <li>
                <a class="dropdown-item @(CurrentLanguage == "en" ? "active" : "")" href="#" @onclick="(() => ChangeLanguage("en"))" @onclick:preventDefault>
                    <span class="language-flag">🇬🇧</span>
                    <span>English</span>
                </a>
            </li>
        </ul>
    </div>
</div>

@code {
    [Parameter] public string CurrentLanguage { get; set; } = "ti"; // Default: Tigrinya
    [Parameter] public EventCallback<string> CurrentLanguageChanged { get; set; }
    [Parameter] public EventCallback<string> OnLanguageChange { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Load saved language preference from localStorage
        try
        {
            var savedLanguage = await JS.InvokeAsync<string>("localStorage.getItem", "hdss_language");
            if (!string.IsNullOrEmpty(savedLanguage) && IsValidLanguage(savedLanguage))
            {
                CurrentLanguage = savedLanguage;
                await CurrentLanguageChanged.InvokeAsync(CurrentLanguage);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading language preference: {ex.Message}");
        }
    }

    private async Task ChangeLanguage(string newLanguage)
    {
        if (!IsValidLanguage(newLanguage) || newLanguage == CurrentLanguage)
            return;

        CurrentLanguage = newLanguage;

        try
        {
            // Save to localStorage for persistence
            await JS.InvokeVoidAsync("localStorage.setItem", "hdss_language", newLanguage);

            // Notify parent components
            await CurrentLanguageChanged.InvokeAsync(CurrentLanguage);
            await OnLanguageChange.InvokeAsync(CurrentLanguage);

            // Note: Full page reload may be needed for complete localization
            // For now, components will react to language change events
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving language preference: {ex.Message}");
        }
    }

    private bool IsValidLanguage(string lang)
    {
        return lang is "ti" or "am" or "en";
    }

    private string GetLanguageFlag(string lang)
    {
        return lang switch
        {
            "ti" or "am" => "🇪🇹", // Ethiopian flag for Tigrinya and Amharic
            "en" => "🇬🇧",         // UK flag for English
            _ => "🌐"              // Globe for unknown
        };
    }

    private string GetLanguageName(string lang)
    {
        return lang switch
        {
            "ti" => "ትግርኛ",  // Tigrinya in Ge'ez script
            "am" => "አማርኛ",  // Amharic in Ge'ez script
            "en" => "English",
            _ => "Language"
        };
    }
}

<style>
    .language-switcher {
        display: inline-block;
    }

    .language-switcher .btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.75rem;
    }

    .language-switcher .language-flag {
        font-size: 1.25rem;
    }

    .language-switcher .language-name {
        font-size: 0.9rem;
        font-weight: 500;
    }

    .language-switcher .dropdown-menu {
        min-width: 200px;
    }

    .language-switcher .dropdown-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
    }

    .language-switcher .dropdown-item.active {
        background-color: #0d6efd;
        color: white;
    }

    .language-switcher .dropdown-item:hover:not(.active) {
        background-color: #f8f9fa;
    }

    .language-switcher .ethiopic-text {
        font-family: 'Noto Sans Ethiopic', 'Abyssinica SIL', sans-serif;
        font-size: 1rem;
        font-weight: 500;
    }

    .language-switcher .text-muted {
        font-size: 0.75rem;
        margin-left: auto;
    }

    @media (max-width: 768px) {
        .language-switcher .language-name {
            display: none; /* Hide language name on mobile, show flag only */
        }
    }
</style>

@* JavaScript for Bootstrap dropdown (include in _Host.cshtml or _Layout.cshtml) *@
@* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> *@
