@* Hierarchical Location Picker for Kilte Awlalo HDSS *@
@* Cascading selection: Woreda → Tabia → Kushet → Gott *@
@* Usage: <LocationPicker @bind-TabiaCode="tabiaCode" @bind-KushetCode="kushetCode" Language="@language" /> *@

@inject HttpClient Http

<div class="location-picker">
    <div class="row g-2">
        @* Woreda (fixed for Kilte Awlalo) *@
        <div class="col-12 col-md-3">
            <label class="form-label small mb-1">
                @GetLabel("Woreda")
                <span class="text-muted">(ወረዳ)</span>
            </label>
            <input type="text" class="form-control" value="Kilte Awlalo" readonly disabled />
        </div>

        @* Tabia Dropdown *@
        <div class="col-12 col-md-3">
            <label class="form-label small mb-1">
                @GetLabel("Tabia") <span class="text-danger">*</span>
                <span class="text-muted">(ታብያ)</span>
            </label>
            <select class="form-select" @onchange="OnTabiaChanged" value="@TabiaCode">
                <option value="">@GetLabel("SelectTabia")</option>
                @foreach (var tabia in Tabias)
                {
                    <option value="@tabia.Code">@GetTabiaName(tabia)</option>
                }
            </select>
        </div>

        @* Kushet Dropdown (filtered by selected Tabia) *@
        <div class="col-12 col-md-3">
            <label class="form-label small mb-1">
                @GetLabel("Kushet")
                <span class="text-muted">(ኩሸት)</span>
            </label>
            <select class="form-select" @onchange="OnKushetChanged" value="@KushetCode" disabled="@string.IsNullOrEmpty(TabiaCode)">
                <option value="">@GetLabel("SelectKushet")</option>
                @foreach (var kushet in FilteredKushets)
                {
                    <option value="@kushet.Code">@GetKushetName(kushet)</option>
                }
            </select>
            @if (string.IsNullOrEmpty(TabiaCode))
            {
                <small class="text-muted">@GetLabel("SelectTabiaFirst")</small>
            }
        </div>

        @* Gott/Sub-village (optional, free text) *@
        <div class="col-12 col-md-3">
            <label class="form-label small mb-1">
                @GetLabel("Gott") @GetLabel("Optional")
                <span class="text-muted">(ጎጥ)</span>
            </label>
            <input type="text" class="form-control" placeholder="@GetLabel("GottPlaceholder")"
                   value="@Gott" @onchange="OnGottChanged" />
        </div>
    </div>

    @* Population info (helpful context) *@
    @if (!string.IsNullOrEmpty(TabiaCode) && SelectedTabia != null)
    {
        <div class="row mt-2">
            <div class="col-12">
                <small class="text-muted">
                    📍 @GetTabiaName(SelectedTabia) - @GetLabel("Population"): ~@SelectedTabia.PopulationEstimate
                    @if (!string.IsNullOrEmpty(KushetCode) && SelectedKushet != null)
                    {
                        <span> | @GetKushetName(SelectedKushet) - ~@SelectedKushet.PopulationEstimate</span>
                    }
                </small>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? TabiaCode { get; set; }
    [Parameter] public EventCallback<string?> TabiaCodeChanged { get; set; }

    [Parameter] public string? KushetCode { get; set; }
    [Parameter] public EventCallback<string?> KushetCodeChanged { get; set; }

    [Parameter] public string? Gott { get; set; }
    [Parameter] public EventCallback<string?> GottChanged { get; set; }

    [Parameter] public string Language { get; set; } = "ti"; // ti, am, en

    // Kilte Awlalo Tabias (10)
