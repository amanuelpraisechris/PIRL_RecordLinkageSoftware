{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "hdss.ephi.gov.et;hdss.moh.gov.et",

  "Jwt": {
    "Issuer": "https://hdss.ephi.gov.et",
    "Audience": "https://hdss.ephi.gov.et",
    "Key": "CHANGE_THIS_TO_STRONG_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG"
  },

  "Supabase": {
    "ConnectionString": "Host=localhost;Database=ethiopian_hdss;Username=hdss_app;Password=USE_ENVIRONMENT_VARIABLE"
  },

  "Security": {
    "RequireHttps": true,
    "SessionTimeout": 30,
    "MaxLoginAttempts": 5,
    "LockoutDuration": 15,
    "PasswordPolicy": {
      "MinLength": 8,
      "RequireDigit": true,
      "RequireUppercase": true,
      "RequireSpecialChar": true
    }
  },

  "RateLimiting": {
    "RequestsPerMinute": 100,
    "RequestsPerHour": 1000
  }
}
